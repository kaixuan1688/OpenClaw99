{
  "name": "OpenClaw",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "npm install -g openclaw",
  "postStartCommand": "nohup openclaw gateway run > /tmp/openclaw-gateway.log 2>&1 &",
  "forwardPorts": [18789]
}
